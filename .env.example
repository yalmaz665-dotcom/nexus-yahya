# Nexus Yahya - Environment Configuration
# Render.com Deployment

# Server
ENVIRONMENT=production
PORT=8000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/nexus_yahya

# API Keys
OPENAI_API_KEY=your_openai_api_key_here
GITHUB_TOKEN=your_github_token_here

# Security
SECRET_KEY=your_secret_key_here
JWT_SECRET=your_jwt_secret_here

# CORS
CORS_ORIGINS=["https://nexus-yahya.vercel.app", "http://localhost:3000"]

# Logging
LOG_LEVEL=INFO

# Monitoring
SENTRY_DSN=your_sentry_dsn_here
